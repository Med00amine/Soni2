APP_ENV=development

# --- Narration: text to speech -------------------------------------------
# elevenlabs | fishaudio | deepgram | mock
#   mock generates placeholder audio and needs no account, so the whole
#   pipeline can be developed and tested without spending anything.
TTS_PROVIDER=deepgram
# Voice for the active provider. Leave blank to use that provider's default
# Spain-Spanish voice.
#   deepgram  aura-2-diana-es | aura-2-carina-es | aura-2-alvaro-es | aura-2-nestor-es  (es-ES)
#   fishaudio 3f065d660212478a9c697fa965b4d098  (Carmen, es-ES)
TTS_VOICE_ID=aura-2-diana-es
# Refuse to narrate with a voice the provider does not document as Spain
# Spanish. Set to false only if a Latin American voice is wanted on purpose.
REQUIRE_PENINSULAR_VOICE=true

# --- Speech review: speech to text ---------------------------------------
# Transcribes the generated audio so it can be compared with the expected
# spoken text. auto | fishaudio | deepgram | mock | none
#   auto uses whichever provider has credentials, preferring Deepgram.
ASR_PROVIDER=auto
# A second, independent recognizer consulted only when the first one hears a
# difference: it decides whether the narration or the recognizer is wrong.
# auto | elevenlabs | deepgram | fishaudio | none. elevenlabs = Scribe v2,
# billed by audio time, using the ElevenLabs key.
ASR_SECONDARY_PROVIDER=auto
# Paid automatic retakes per paragraph before a person decides.
QA_MAX_RETAKES=2

# --- Provider credentials -------------------------------------------------
DEEPGRAM_API_KEY=
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=3f065d660212478a9c697fa965b4d098
FISH_AUDIO_EXTRA_VOICE_IDS=fb9d5855f185451983404deb10788ad4,ec0718028a2445fb9be8e8bfb56a0150
FISH_AUDIO_MODEL=drama-3
# ElevenLabs narrates with a voice chosen by id from its voice library (the id
# is the last part of the voice's page address). The key needs only the
# "Text to Speech" permission. Every paragraph is sent with its neighbours as
# context, which ElevenLabs does not bill, so the joins sound continuous.
ELEVENLABS_API_KEY=
# Gabo, a Peninsular Spanish narrator from the ElevenLabs library. Format:
# id, or id|es-ES|Name to declare the accent and name yourself.
ELEVENLABS_VOICE_ID=o0SveC0zgHFuCsEO3vHR
# More voices to offer in the voice list, comma separated.
ELEVENLABS_EXTRA_VOICE_IDS=
# When the key may read voices, Soni2 asks ElevenLabs at start-up which models
# a voice is verified Peninsular Spanish on, and the accent check uses that.
# Otherwise name the voice here and declare its accent (es-ES): only an es-ES
# voice passes REQUIRE_PENINSULAR_VOICE=true.
ELEVENLABS_VOICE_NAME=
ELEVENLABS_VOICE_LANGUAGE=
# Chosen by benchmark (docs/quality-system.md): on the same Spanish passages
# eleven_v4 had no detected content error with either recognizer and read
# raw dates, amounts and abbreviations correctly; eleven_multilingual_v2 and
# eleven_flash_v2_5 misread them unless Soni2 normalizes the text first.
ELEVENLABS_MODEL_ID=eleven_v4
# Voice settings for every request. Leave blank to keep the voice's own.
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY_BOOST=
ELEVENLABS_STYLE=

# --- Limits and storage ---------------------------------------------------
MAX_UPLOAD_SIZE_MB=200
PREVIEW_CHARACTERS=5000
# Jobs, the narration cache and the SQLite database live here. Keep it on
# persistent storage: the narration cache is what stops you paying twice.
JOB_STORAGE_DIR=/data
QUALITY_REVIEW_ENABLED=true
# Paragraphs narrated at the same time. 0 = a safe default for the provider
# (Deepgram 8, its limit is 15; Fish Audio 4, its starter limit is 5;
# ElevenLabs one below the limit it reports for your plan). Raise it only if
# your plan allows more; too many gets requests refused with HTTP 429.
TTS_CONCURRENCY=0

# --- Mastering ------------------------------------------------------------
# Trim each passage's dead air, put deliberate pauses back, and level the whole
# book so it plays at one comfortable volume. Needs ffmpeg (the Docker image
# has it). With this off the audio is joined as before and the job log says so.
AUDIO_MASTERING=true
# Integrated loudness target. -18 LUFS is comfortable on phones and screen
# readers; audiobook shops often ask for -18 to -23.
AUDIO_TARGET_LUFS=-18
# The pause after each paragraph, and the longer one between chapters, in
# milliseconds. This is how a listener who cannot see the page hears structure.
AUDIO_PARAGRAPH_GAP_MS=350
AUDIO_CHAPTER_GAP_MS=900

# --- ONCE delivery templates ---------------------------------------------
# Blank until the official ONCE wording and filenames are confirmed.
ONCE_INTRO_TEMPLATE=
ONCE_BIBLIOGRAPHIC_TEMPLATE=
ONCE_IDENTIFICATION_STATEMENT=
ONCE_LEGAL_STATEMENT=
ONCE_INTRO_FILENAME=
ONCE_BIBLIOGRAPHIC_FILENAME=

# --- Frontend / CORS ------------------------------------------------------
VITE_API_URL=
VITE_BACKEND_PROXY_TARGET=http://backend:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
